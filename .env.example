# Copy this file to .env and adjust as needed.
# .env is git-ignored — never commit real values.

# Optional: override the basemap style URL (defaults to free CARTO dark style).
# Any MapLibre-compatible style JSON URL works (MapTiler, Protomaps, self-hosted, etc.)
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
